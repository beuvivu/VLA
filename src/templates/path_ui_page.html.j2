<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-src 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" />
  <meta name="referrer" content="no-referrer" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="assets/ui-part1.css" />
  <link rel="stylesheet" href="assets/ui-part2.css" />
  <link rel="stylesheet" href="assets/ui-part3.css" />
  <link rel="stylesheet" href="assets/ui-visual-system.css" data-ui-visual-system />
  <style>
    :root{
      --bg:#F4F5FF;--card:rgba(255,255,255,.90);--text:#0f172a;--muted:#64748b;--line:#dbe3f0;
      --hit:#f59e0b;--hitde:#dc2626;--ok:#059669;--chip:#eef2ff;
      --ui-bg:#F4F5FF;--ui-surface:rgba(255,255,255,.94);--ui-surface-2:#f8fafc;
      --ui-ink:#0f172a;--ui-ink-2:#334155;--ui-ink-soft:#64748b;--ui-ink-muted:#64748b;
      --ui-border:#dbe3f0;--ui-border-strong:#cbd5e1;
      --ui-brand:#4f46e5;--ui-brand-ink:#4338ca;--ui-brand-soft:#eef2ff;--ui-brand-border:#c7d2fe;
      --ui-on-brand:#ffffff;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:var(--ui-font);background:linear-gradient(135deg,#F4F5FF 0%,#EAEBFF 48%,#E8ECFF 100%);color:var(--text)}
    a{color:#4338ca;text-decoration:none}a:hover{text-decoration:underline}
    .path-shell{max-width:1280px;margin:0 auto;padding:clamp(16px,2.4vw,28px);padding-bottom:calc(var(--ui-dock-h,64px) + env(safe-area-inset-bottom) + 36px)}
    .path-hero{display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:space-between;padding:18px 20px;border:1px solid rgba(255,255,255,.96);border-radius:22px;background:rgba(255,255,255,.88);box-shadow:0 12px 36px rgba(15,23,42,.06);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
    .path-hero h1{letter-spacing:-.03em}
    .card{background:var(--card);border:1px solid rgba(255,255,255,.96);border-radius:20px;padding:16px;box-shadow:0 10px 32px rgba(15,23,42,.05);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
    .kpi{display:flex;gap:8px;flex-wrap:wrap}
    .chip{background:var(--chip);border:1px solid #dbe3f0;border-radius:999px;padding:6px 10px;font-size:12px;color:#475569;font-weight:700}
    .legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;color:#475569}
    .dot{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:middle}
    .dot.hit{background:var(--hit)}.dot.hitde{background:var(--hitde)}.dot.none{background:#94a3b8}
    table{width:100%;border-collapse:separate;border-spacing:0;background:transparent;font-variant-numeric:tabular-nums}
    th,td{border-bottom:1px solid #e2e8f0;padding:9px 8px;text-align:center;font-size:12px}
    th{position:sticky;top:0;background:rgba(248,250,252,.98);color:#334155;z-index:3}
    td{color:#0f172a}td.left,th.left{text-align:left}tr:hover td{background:#f8faff}
    .cell{display:inline-flex;gap:6px;align-items:center;justify-content:center;min-width:42px;padding:5px 7px;border-radius:9px;border:1px solid #dbe3f0;background:#fff;color:#0f172a}
    .cell.hit{background:#fff7ed;border-color:#fdba74;color:#9a3412}
    .cell.hitde{background:#FEE2E2;border-color:#f87171;color:#DC2626;font-weight:800}
    .cell.none{background-color:#E2E8F0;background-image:repeating-linear-gradient(135deg,transparent 0 7px,rgba(156,163,175,.34) 7px 8px);color:#475569}
    .small{font-size:11px;color:var(--muted);line-height:1.5}
    .btn{display:inline-block;background:#4f46e5;color:#fff;padding:8px 11px;border-radius:10px;border:1px solid #4f46e5;font-weight:700}
    .btn:hover{text-decoration:none;background:#4338ca}.btn.secondary{background:#fff;color:#334155;border-color:#dbe3f0}.btn.secondary:hover{background:#eef2ff}
    .path-overview{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(18rem,.85fr);gap:14px;align-items:stretch;margin-top:14px}
    .path-overview>.card{display:flex;flex-direction:column;min-height:0}
    .quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:10px}
    .quick-pick{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 11px;border:1px solid #dbe3f0;border-radius:12px;background:#fff;color:var(--text);text-decoration:none;transition:transform .16s ease,border-color .16s ease,background .16s ease}
    .quick-pick:hover{background:#eef2ff;border-color:#a5b4fc;transform:translateY(-1px);text-decoration:none}
    .quick-number{font-size:16px;font-weight:800;letter-spacing:.04em}.quick-meta{font-size:10px;color:var(--muted);text-align:right;line-height:1.35}
    .empty-state{margin-top:10px;padding:10px;border:1px dashed #cbd5e1;border-radius:10px;color:var(--muted);font-size:12px;background:#f8fafc}
    .pick-scroll{flex:1 1 auto;min-height:0;max-height:26rem;overflow:auto;border:1px solid #e2e8f0;border-radius:12px}
    .path-matrix-card{margin-top:14px;overflow:hidden}
    .path-table-scroll{margin-top:10px;max-height:min(66vh,52rem);overflow:auto;overscroll-behavior:contain;border:1px solid #dbe3f0;border-radius:14px;background:#fff}
    .path-table-scroll table{margin:0;min-width:max-content}.path-table-scroll th{top:0;box-shadow:0 1px 0 #dbe3f0}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
    .path-footer{margin-top:14px;color:var(--muted);padding-bottom:8px}
    @media(max-width:979px){.path-overview{grid-template-columns:1fr}.path-table-scroll{max-height:58vh}}
    @media(max-width:640px){.path-shell{padding:12px 12px calc(var(--ui-dock-h,64px) + env(safe-area-inset-bottom) + 32px)}.path-hero{padding:14px;border-radius:16px}.card{border-radius:16px;padding:13px}.quick-grid{grid-template-columns:1fr}.kpi{width:100%}.chip{font-size:11px}}
  </style>
</head>
<body class="ui-app ui-dock-space path-page">
<div class="wrap path-shell">
  <div class="top path-hero">
    <div>
      <h1 style="margin:0;font-size:clamp(20px,3vw,30px)">{{ title }}</h1>
      <div class="small">Ngày neo (biên ngày cầu chạy): <b>{{ anchor_date }}</b> · Số ngày cầu chạy: <b>{{ display_days }}</b> · Loại: <b>{{ mode_label }}</b> · Trạng thái: <b>{{ kind_label }}</b></div>
    </div>
    <div class="kpi">
      <span class="chip">Màu đỏ: về Đặc Biệt</span>
      <span class="chip">Màu cam: loto đã về</span>
      <span class="chip">Gợi ý ô: độ trễ + vị trí dữ liệu gốc</span>
    </div>
  </div>

  <div class="grid path-overview" style="margin-top:12px">
    <div class="card">
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between">
        <div><b>Gợi ý ngày mai (xác suất)</b><div class="small">Tỷ lệ tổng hợp từ các đường cầu đủ điều kiện ({{ kind_label }}).</div></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          {% if other_link %}<a class="btn secondary" href="{{ other_link }}">Xem {{ other_kind_label }} ({{ other_mode_label }})</a>{% endif %}
          {% if index_link %}<a class="btn secondary" href="{{ index_link }}">Trang tổng hợp</a>{% endif %}
        </div>
      </div>
      <div class="pick-scroll" style="margin-top:10px">
        <table>
          <thead><tr><th>Hạng</th><th>Số</th><th>%</th><th>Số đường hỗ trợ</th></tr></thead>
          <tbody>
            {% for r in picks %}
            <tr>
              <td>{{ loop.index }}</td>
              <td class="mono">{{ "%02d"|format(r.number) }}</td>
              <td>{{ (r.prob*100)|round(2) }}</td>
              <td>{{ r.support_paths_count }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <b>Chọn nhanh</b>
      <div class="small" style="margin-top:6px">Trang tĩnh, dữ liệu dựng sẵn.</div>
      <div class="legend">
        <span><span class="dot hitde"></span>Về Đặc Biệt</span>
        <span><span class="dot hit"></span>Về loto</span>
        <span><span class="dot none"></span>Không về</span>
      </div>
      {% if picks %}
      <div class="quick-grid" aria-label="Danh sách chọn nhanh">
        {% for r in picks[:10] %}
        <div class="quick-pick" title="Số {{ '%02d'|format(r.number) }} · điểm {{ (r.prob*100)|round(2) }}% · hỗ trợ {{ r.support_paths_count }} đường cầu">
          <span class="quick-number mono">{{ "%02d"|format(r.number) }}</span>
          <span class="quick-meta"><b>{{ (r.prob*100)|round(2) }}%</b><br>{{ r.support_paths_count }} đường cầu</span>
        </div>
        {% endfor %}
      </div>
      <div class="small" style="margin-top:8px"><i>Hiển thị 10 số đứng đầu theo điểm tổng hợp; đây là điểm xếp hạng, không phải xác suất đã hiệu chuẩn.</i></div>
      {% else %}
      <div class="empty-state">Không có đường cầu nào đủ điều kiện ở ngày neo này, nên chưa có danh sách chọn nhanh.</div>
      {% endif %}
      <div style="margin-top:10px" class="small">
        Mẹo: có thể tăng/giảm <span class="mono">--so-ngay</span>, <span class="mono">--lag-max</span>, <span class="mono">--window-days</span> trong quy trình/CLI để điều chỉnh “biên độ” hiển thị.
      </div>
    </div>
  </div>

  <div class="card path-matrix-card" style="margin-top:12px; overflow:hidden">
    <b>Bảng đường cầu (dữ liệu gốc → số) theo ngày</b>
    <div class="small" style="margin-top:6px">Mỗi hàng là một đường cầu; mỗi cột là một ngày trong “Số ngày cầu chạy”. Ô hiển thị số do đường cầu tạo ra tại ngày đó và được tô màu nếu đã về.</div>
    {% if not rows %}
    <div class="ui-empty" role="status">
      <span class="ui-empty-icon" aria-hidden="true">◌</span>
      <h3>Hôm nay không có đường cầu {{ kind_label|lower }} nào</h3>
      {% if empty_reason %}
      <p>Đây là trạng thái bình thường, không phải lỗi dữ liệu. Bộ quét đã chạy đủ và kết luận không đường cầu nào đạt ngưỡng {{ empty_reason.threshold }} nhịp liên tiếp.</p>
      <div class="ui-empty-why">
        {% if empty_reason.is_de %}
        <p style="margin:0 0 .5rem">Với Đặc Biệt, tỉ lệ trúng của một con là <b>{{ empty_reason.baseline_pct }}%</b>, nên xác suất một đường cầu trúng {{ empty_reason.threshold }} kỳ liên tiếp chỉ khoảng <b>{{ "%.6f"|format(empty_reason.chance_pct) }}%</b>. Rỗng là kết quả thường gặp, và hạ ngưỡng để “có dữ liệu” sẽ tạo ra tín hiệu giả.</p>
        {% else %}
        <p style="margin:0 0 .5rem">Tỉ lệ trúng nền của một con là <b>{{ empty_reason.baseline_pct }}%</b>; xác suất trúng {{ empty_reason.threshold }} kỳ liên tiếp là khoảng <b>{{ "%.4f"|format(empty_reason.chance_pct) }}%</b>.</p>
        {% endif %}
        {% if empty_reason.sibling_rows %}
        <p style="margin:0">Trang <a href="{{ empty_reason.sibling_link }}">{{ empty_reason.sibling_label }}</a> hiện có <b>{{ empty_reason.sibling_rows }}</b> đường cầu đủ điều kiện.</p>
        {% endif %}
      </div>
      {% else %}
      <p>Chưa có dữ liệu cho ngày neo này.</p>
      {% endif %}
    </div>
    {% else %}
    <div class="path-table-scroll" style="margin-top:10px; overflow:auto">
      <table id="path-table">
        <thead>
          <tr>
            <th class="left">Đường cầu</th>
            <th>Tỷ lệ lịch sử</th>
            <th>Chuỗi liên tiếp</th>
            {% for d in days %}
              <th class="mono">{{ d[5:] }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          <tr>
            <td class="left">
              <div class="mono">{{ row.path_id }}</div>
              <div class="small">trễ={{ row.lag }} · A={{ row.i }} ({{ row.i_label }}) · B={{ row.j }} ({{ row.j_label }})</div>
            </td>
            <td>{{ (row.p_mean*100)|round(2) }}</td>
            <td class="mono">{{ row.streak }}</td>
            {% for cell in row.cells %}
              {% if cell.hitde %}
                <td title="{{ cell.tooltip }}"><span class="cell hitde mono">{{ "%02d"|format(cell.num) }}</span></td>
              {% elif cell.hit %}
                <td title="{{ cell.tooltip }}"><span class="cell hit mono">{{ "%02d"|format(cell.num) }}</span></td>
              {% else %}
                <td title="{{ cell.tooltip }}"><span class="cell none mono">{{ "%02d"|format(cell.num) }}</span></td>
              {% endif %}
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>

  <div class="small path-footer" style="margin-top:14px;color:var(--muted)">
    Được tạo bởi <span class="mono">src/build_docs.py</span> · Nguồn dữ liệu: thu thập cục bộ, có dự phòng nhiều nguồn.
  </div>
</div>
{{ dock_html|safe }}
</body>
</html>
