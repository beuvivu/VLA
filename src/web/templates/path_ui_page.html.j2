<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-src 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'" />
  <meta name="referrer" content="no-referrer" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="assets/ui.css" />
  <link rel="stylesheet" href="assets/ui-visual-system.css" data-ui-visual-system />
  <style>
    :root{--bg:var(--ui-bg);--card:var(--ui-surface);--text:var(--ui-ink);--muted:var(--ui-ink-soft);--line:var(--ui-border)}
    {% include 'path_explorer.css' %}
  </style>
</head>
<body class="ui-app path-page">
<div class="wrap path-shell">
  <header class="path-heading">
    <div><a class="path-back" href="soi-cau-vi-tri.html">← Soi cầu vị trí</a><h1>{{ title }}</h1>
      <p>Đọc hai chữ số của một kỳ trước, ghép thành một số và đối chiếu với kỳ sau.</p></div>
    <div class="path-dates"><span>Dữ liệu đến <b>{{ anchor_date }}</b></span><span>{{ rows|length }} đường cầu đủ điều kiện đang hiển thị</span></div>
  </header>
  <nav class="path-nav" aria-label="Chọn loại đường cầu">
    {% for mode_key, mode_name in [('loto', 'LOTO'), ('de', 'Đặc Biệt')] %}
    {% for kind_key, kind_name in [('active', 'Đang chạy'), ('stable', 'Từng có chuỗi')] %}
    <a href="soi-path-{{ mode_key }}-{{ kind_key }}.html"{% if mode == mode_key and kind == kind_key %} aria-current="page"{% endif %}>{{ mode_name }} <span>{{ kind_name }}</span></a>
    {% endfor %}{% endfor %}
  </nav>
  <ol class="path-steps" data-app-workspace-guide aria-label="Ba bước đọc đường cầu">
    <li><b>1</b> Chọn số hoặc đường cầu</li><li><b>2</b> Xem hai chữ số nguồn</li><li><b>3</b> Đối chiếu từng kỳ</li>
  </ol>

  <section class="path-card path-picks" aria-labelledby="path-picks-title">
    <div class="path-section-head"><div><h2 id="path-picks-title">Số được các đường cầu báo cho kỳ tới</h2>
      <p>Xác suất trúng kỳ tới: trung bình dự báo của các đường cầu đủ điều kiện cùng báo con ấy. Bấm một số để xem những đường cầu có trong danh sách bên dưới.</p></div><span class="path-kind">{{ kind_label }}</span></div>
    {% if picks %}
    <div class="quick-grid" aria-label="Danh sách chọn nhanh">
      {% for r in picks[:10] %}
      <button type="button" class="quick-pick" data-path-number="{{ '%02d'|format(r.number) }}" aria-pressed="false">
        <b class="quick-number">{{ '%02d'|format(r.number) }}</b><span class="quick-meta"><strong>{{ (r.prob*100)|round(2) }}%</strong><span>{{ r.support_paths_count }} đường cầu</span></span>
      </button>
      {% endfor %}
    </div>
    <p class="path-note">Số hỗ trợ tính trên toàn bộ đường cầu đủ điều kiện; danh sách đang hiển thị chỉ gồm {{ rows|length }} đường cầu được xuất ra. Vì vậy số đường tìm thấy bên dưới có thể ít hơn số hỗ trợ.</p>
    <details class="path-pick-more"><summary>Xem đủ {{ picks|length }} số và xác suất</summary>
      <div class="path-table-scroll" tabindex="0" role="region" aria-label="Bảng số được báo"><table><thead><tr><th>Hạng</th><th>Số</th><th>Xác suất %</th><th>Toàn bộ hỗ trợ</th></tr></thead><tbody>
      {% for r in picks %}<tr><td>{{ loop.index }}</td><td class="path-number">{{ '%02d'|format(r.number) }}</td><td>{{ (r.prob*100)|round(2) }}</td><td>{{ r.support_paths_count }}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    {% else %}<p class="empty-state">Không có đường cầu nào đủ điều kiện ở ngày này, nên chưa có danh sách chọn nhanh.</p>{% endif %}
  </section>

  {% if not rows %}
  <section class="ui-empty path-empty path-card" role="status">
    <p class="path-empty-count">0 đường cầu đạt điều kiện</p><h2>Chưa có đường cầu {{ kind_label|lower }} để đối chiếu</h2>
    {% if empty_reason %}
    <p>Chưa có đường cầu nối đủ {{ empty_reason.threshold }} kỳ liên tiếp{% if kind == 'active' %} tính đến {{ anchor_date }}{% else %} trong lịch sử đang đối chiếu{% endif %}.</p>
    <div class="ui-empty-why"><p>Với tỉ lệ nền {{ empty_reason.baseline_pct }}% cho một số {{ mode_label }}, một đường cầu trúng {{ empty_reason.threshold }} kỳ liên tiếp có xác suất khoảng {{ '%.6f'|format(empty_reason.chance_pct) }}%.</p>
    {% if empty_reason.sibling_rows %}<p><a class="path-action" href="{{ empty_reason.sibling_link }}">Xem {{ empty_reason.sibling_rows }} đường cầu {{ empty_reason.sibling_label|lower }} →</a></p>{% endif %}</div>
    {% else %}<p>Chưa có dữ liệu cho ngày này.</p>{% endif %}
  </section>
  {% else %}
  <section class="path-card path-explorer" aria-labelledby="path-explorer-title">
    <div class="path-section-head"><div><h2 id="path-explorer-title">Đọc từng đường cầu</h2><p>Ngày nguồn = ngày cần đối chiếu − độ trễ. Hai chữ số giữ đúng thứ tự trái → phải.</p></div><span class="path-kind">{{ display_days }} kỳ đối chiếu</span></div>
    <div class="path-toolbar">
      <label>Lọc số được báo cho kỳ tới<input id="path-number-filter" inputmode="numeric" maxlength="2" placeholder="00–99" aria-describedby="path-filter-help" /></label>
      <label>Số kỳ gần nhất<select id="path-days-filter"><option value="5">5 kỳ</option><option value="10" selected>10 kỳ</option><option value="all">Tất cả đã nhúng</option></select></label>
      <button id="path-reset" type="button">Bỏ lọc</button>
      <p id="path-filter-help">Bộ lọc chỉ chọn trong danh sách đã xuất; không thay đổi điều kiện hay xác suất của mô hình.</p>
    </div>
    <p id="path-status" role="status" aria-live="polite">{{ rows|length }} đường cầu đang hiển thị. Chọn “Xem đường cầu” để đọc căn cứ.</p>
    <div class="path-workspace">
      <section id="path-detail" class="path-detail" aria-labelledby="path-detail-title"><h3 id="path-detail-title">Nguồn → số ghép → kết quả</h3><p>Chọn một đường cầu trong danh sách để xem hai chữ số nguồn và kết quả từng kỳ.</p></section>
      <div class="path-list">
        <div class="path-table-scroll" tabindex="0" role="region" aria-label="Danh sách đường cầu">
          <table id="path-table"><thead><tr><th>Đường cầu</th><th>Báo kỳ tới</th><th>Dự báo kỳ tới (%)</th><th>Tỷ lệ lịch sử (%)</th></tr></thead><tbody>
          {% for row in rows %}<tr data-path-row="{{ loop.index0 }}">
            <td><button type="button" class="path-select" data-path-index="{{ loop.index0 }}" aria-pressed="false"><b>Xem đường cầu {{ loop.index }}</b><span>Trễ {{ row.lag }} ngày · {{ row.streak }}</span></button><small>{{ row.i_label }} + {{ row.j_label }}</small></td>
            <td class="path-number">{{ row.next_num|default('—', true) }}</td><td>{% if row.p_next is defined and row.p_next is not none %}{{ (row.p_next*100)|round(2) }}{% else %}—{% endif %}</td><td>{{ (row.p_mean*100)|round(2) }}</td>
          </tr>{% endfor %}
          </tbody></table>
        </div>
        <p class="path-note">“Tỷ lệ lịch sử” là số lần trúng trong mẫu; “Dự báo kỳ tới” là xác suất đã co theo kinh nghiệm của mọi đường cầu. Hai cột có ý nghĩa khác nhau.</p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if experience %}
  <details class="path-card path-experience"><summary>Kinh nghiệm học từ mọi đường cầu</summary>
    <p class="path-note">Ngày neo {{ experience.anchor_date }} · {{ experience.rules }} đường cầu ({{ experience.scope_text }}), mỗi đường chấm trên {{ experience.trials }} kỳ gần nhất · tỉ lệ trúng chung {{ experience.base_pct }}%.</p>
    <p class="path-experience-verdict">{{ experience.verdict }}</p>
    {% if experience.streak_rows %}<div class="path-table-scroll" tabindex="0" role="region" aria-label="Kiểm chứng chuỗi đường cầu"><table class="path-experience-table">
      <caption>Cầu đang chạy s kỳ liên tiếp thì kỳ kế tiếp trúng bao nhiêu — đếm trên mọi đường cầu{% if experience.uses_streak %}; cột «Dự báo» là phần nhánh đang chạy dùng{% endif %}.</caption>
      <thead><tr><th>Chuỗi trước kỳ</th><th>Số lần chấm</th><th>Trúng tiếp</th><th>Dự báo</th></tr></thead><tbody>{% for row in experience.streak_rows %}<tr><td>{{ row.label }}</td><td>{{ row.trials }}</td><td>{{ row.raw }}%</td><td>{{ row.post }}%</td></tr>{% endfor %}</tbody>
    </table></div>{% endif %}<p class="path-note">{{ experience.streak_verdict }} Các lần chấm của những cầu cùng kỳ tương quan với nhau, nên số lần ở đây không phải số quan sát độc lập.</p>
  </details>{% endif %}
  <p class="path-footer">Dữ liệu đến {{ anchor_date }} · Thống kê lịch sử và căn cứ theo từng đường cầu.</p>
</div>
<script id="path-data" type="application/json">{{ path_payload_json|default('{}')|safe }}</script>
<script>{% include 'path_explorer.js' %}</script>
</body>
</html>
